---
import BaseLayout from '@layouts/BaseLayout.astro';
import { team } from '@data/team';

export function getStaticPaths() {
  return team.map((member) => ({
    params: { id: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
---

<BaseLayout title={member.name} description={member.bio}>
  <section class="member-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/team">Equipo</a>
        <span>/</span>
        <span>{member.name}</span>
      </nav>

      <div class="member-hero__grid">
        <div class="member-hero__image" transition:name={`team-image-${member.id}`}>
          <img src={member.image} alt={member.name} />
        </div>

        <div class="member-hero__info">
          <h1>{member.name}</h1>
          <p class="member-hero__position">{member.position}</p>
          <p class="member-hero__specialty">{member.specialty}</p>

          <div class="member-hero__contact">
            <a href={`mailto:${member.email}`} class="contact-button">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>{member.email}</span>
            </a>
            <a href={`tel:${member.phone}`} class="contact-button">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>{member.phone}</span>
            </a>
            {member.linkedin && (
              <a href={member.linkedin} target="_blank" rel="noopener" class="contact-button">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
                <span>LinkedIn</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="member-content section">
    <div class="container">
      <div class="content-layout">
        <!-- Biography -->
        <div class="content-block">
          <h2>Biografía</h2>
          <p class="bio-text">{member.bio}</p>
        </div>

        <!-- Education -->
        <div class="content-block">
          <h2>Educación</h2>
          <ul class="timeline-list">
            {member.education.map((edu) => (
              <li>
                <div class="timeline-dot"></div>
                <p>{edu}</p>
              </li>
            ))}
          </ul>
        </div>

        <!-- Experience -->
        <div class="content-block">
          <h2>Experiencia Profesional</h2>
          <ul class="timeline-list">
            {member.experience.map((exp) => (
              <li>
                <div class="timeline-dot"></div>
                <p>{exp}</p>
              </li>
            ))}
          </ul>
        </div>

        <!-- Achievements -->
        <div class="content-block">
          <h2>Logros y Reconocimientos</h2>
          <div class="achievements-grid">
            {member.achievements.map((achievement) => (
              <div class="achievement-card">
                <span class="achievement-icon">🏆</span>
                <p>{achievement}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="member-cta section bg-dark">
    <div class="container">
      <div class="cta-content">
        <h2>¿Necesita asesoría legal de {member.name.split(' ')[0]}?</h2>
        <p>Contacte directamente para una consulta personalizada</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn--primary btn--large">Agendar Consulta</a>
          <a href={`mailto:${member.email}`} class="btn btn--outline btn--large">Enviar Email</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @import '../../styles/variables';
  @import '../../styles/mixins';
  .member-hero {
    background: $accent-cream;
    padding: $spacing-2xl 0 $spacing-3xl;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: $spacing-sm;
    font-size: $font-size-sm;
    margin-bottom: $spacing-xl;
    flex-wrap: wrap;

    a {
      color: $gray-medium;
      transition: color $transition-base;

      &:hover {
        color: $secondary-gold;
      }
    }

    span:not(:last-child) {
      color: $gray-light;
    }

    span:last-child {
      color: $primary-dark;
      font-weight: $font-weight-semibold;
    }
  }

  .member-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-3xl;
    align-items: start;

    @include lg {
      grid-template-columns: 2fr 3fr;
    }
  }

  .member-hero__image {
    border-radius: $radius-lg;
    overflow: hidden;
    box-shadow: $shadow-xl;

    img {
      width: 100%;
      height: auto;
      display: block;
    }
  }

  .member-hero__info {
    h1 {
      font-size: $font-size-3xl;
      color: $primary-dark;
      margin-bottom: $spacing-sm;

      @include md {
        font-size: $font-size-4xl;
      }
    }
  }

  .member-hero__position {
    color: $secondary-gold;
    font-size: $font-size-xl;
    font-weight: $font-weight-semibold;
    margin-bottom: $spacing-xs;
  }

  .member-hero__specialty {
    color: $gray-dark;
    font-size: $font-size-lg;
    margin-bottom: $spacing-xl;
  }

  .member-hero__contact {
    display: flex;
    flex-direction: column;
    gap: $spacing-sm;

    @include md {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .contact-button {
    display: inline-flex;
    align-items: center;
    gap: $spacing-xs;
    padding: $spacing-sm $spacing-md;
    background: $white;
    color: $primary-dark;
    border: 2px solid $gray-light;
    border-radius: $radius-base;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    transition: all $transition-base;
    text-decoration: none;

    svg {
      flex-shrink: 0;
      color: $secondary-gold;
    }

    &:hover {
      border-color: $secondary-gold;
      transform: translateY(-2px);
      box-shadow: $shadow-base;
    }
  }

  .content-layout {
    max-width: 1000px;
    margin: 0 auto;
  }

  .content-block {
    margin-bottom: $spacing-3xl;

    &:last-child {
      margin-bottom: 0;
    }

    h2 {
      font-size: $font-size-2xl;
      color: $primary-dark;
      margin-bottom: $spacing-lg;
      padding-bottom: $spacing-sm;
      border-bottom: 3px solid $secondary-gold;
    }
  }

  .bio-text {
    font-size: $font-size-lg;
    line-height: 1.8;
    color: $gray-dark;
  }

  .timeline-list {
    list-style: none;
    padding: 0;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      left: 8px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: $gray-light;
    }

    li {
      position: relative;
      padding-left: $spacing-xl;
      margin-bottom: $spacing-lg;

      &:last-child {
        margin-bottom: 0;
      }
    }

    .timeline-dot {
      position: absolute;
      left: 0;
      top: 6px;
      width: 18px;
      height: 18px;
      background: $secondary-gold;
      border: 3px solid $white;
      border-radius: $radius-full;
      box-shadow: 0 0 0 2px $gray-light;
    }

    p {
      font-size: $font-size-base;
      line-height: 1.6;
      color: $gray-dark;
      margin: 0;
    }
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-md;

    @include md {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .achievement-card {
    display: flex;
    align-items: flex-start;
    gap: $spacing-md;
    padding: $spacing-lg;
    background: $accent-cream;
    border-radius: $radius-base;
    border-left: 4px solid $secondary-gold;

    .achievement-icon {
      font-size: 2rem;
      flex-shrink: 0;
    }

    p {
      flex: 1;
      margin: 0;
      color: $gray-dark;
      line-height: 1.6;
    }
  }

  .member-cta {
    text-align: center;
  }

  .cta-content {
    h2 {
      color: $white;
      font-size: $font-size-2xl;
      margin-bottom: $spacing-md;

      @include md {
        font-size: $font-size-3xl;
      }
    }

    p {
      font-size: $font-size-lg;
      color: rgba($white, 0.9);
      margin-bottom: $spacing-xl;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: $spacing-md;
    align-items: center;

    @include sm {
      flex-direction: row;
      justify-content: center;
    }
  }

  .btn {
    display: inline-block;
    padding: $spacing-sm $spacing-lg;
    border-radius: $radius-base;
    font-weight: $font-weight-semibold;
    text-align: center;
    transition: all $transition-base;
    border: 2px solid transparent;
    cursor: pointer;
    text-decoration: none;

    &--primary {
      background: $secondary-gold;
      color: $primary-dark;
      border-color: $secondary-gold;

      &:hover {
        background: $secondary-light-gold;
        border-color: $secondary-light-gold;
        transform: translateY(-2px);
        box-shadow: $shadow-md;
      }
    }

    &--outline {
      background: transparent;
      color: $white;
      border-color: $white;

      &:hover {
        background: $white;
        color: $primary-dark;
      }
    }

    &--large {
      padding: $spacing-md $spacing-xl;
      font-size: $font-size-lg;
    }
  }
</style>