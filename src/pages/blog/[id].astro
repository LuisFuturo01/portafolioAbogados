---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts } from '../../data/blog';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const relatedPosts = blogPosts
  .filter(p => p.id !== post.id && (p.category === post.category || p.tags.some(tag => post.tags.includes(tag))))
  .slice(0, 3);
---

<BaseLayout title={post.title} description={post.description}>
  <article class="blog-post">
    <header class="post-header">
      <div class="post-header__image" transition:name={`blog-image-${post.id}`}>
        <img src={post.image} alt={post.title} />
        <div class="post-header__overlay"></div>
      </div>
      <div class="post-header__content">
        <div class="container">
          <nav class="breadcrumb">
            <a href="/blog">Blog</a>
            <span>/</span>
            <span>{post.category}</span>
          </nav>

          <div class="post-meta">
            <span class="category">{post.category}</span>
            <span class="date">
              {post.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
            <span class="read-time">{post.readTime} min lectura</span>
          </div>

          <h1>{post.title}</h1>
          <p class="post-lead">{post.description}</p>

          <div class="post-author">
            <img src={post.authorImage} alt={post.author} />
            <div class="post-author__info">
              <span class="post-author__name">{post.author}</span>
              <span class="post-author__title">Abogado Especializado</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="post-content section">
      <div class="container">
        <div class="content-layout">
          <div class="post-body">
            <div class="content-text">
              <p>{post.content}</p>
              
              <h2>Contexto Legal</h2>
              <p>
                Este artículo proporciona información general sobre {post.title.toLowerCase()} y no debe considerarse 
                como asesoramiento legal específico. Cada caso es único y requiere análisis individualizado por parte 
                de un abogado calificado.
              </p>

              <h2>Consideraciones Importantes</h2>
              <p>
                Es fundamental entender que las leyes y regulaciones pueden variar según la jurisdicción y están sujetas 
                a cambios. Por esta razón, siempre recomendamos consultar con un profesional legal antes de tomar 
                decisiones basadas en esta información.
              </p>

              <h2>¿Necesita Asesoría Personalizada?</h2>
              <p>
                Si se encuentra en una situación que requiere asesoramiento legal profesional relacionado con este tema, 
                nuestro equipo de expertos está disponible para ayudarle. Contacte con nosotros para una consulta inicial.
              </p>
            </div>

            <div class="post-tags">
              <h3>Temas relacionados:</h3>
              <div class="tags-list">
                {post.tags.map(tag => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
            </div>

            <div class="post-share">
              <h3>Compartir artículo:</h3>
              <div class="share-buttons">
                <a href="#" class="share-button" aria-label="Compartir en Facebook">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                  </svg>
                </a>
                <a href="#" class="share-button" aria-label="Compartir en Twitter">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
                  </svg>
                </a>
                <a href="#" class="share-button" aria-label="Compartir en LinkedIn">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                    <rect x="2" y="9" width="4" height="12"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <aside class="post-sidebar">
            <div class="sidebar-card">
              <h3>Sobre el Autor</h3>
              <div class="author-card">
                <img src={post.authorImage} alt={post.author} />
                <h4>{post.author}</h4>
                <p>Abogado especializado con amplia experiencia en {post.category.toLowerCase()}.</p>
                <a href="/team" class="btn-link">Ver perfil completo →</a>
              </div>
            </div>

            <div class="sidebar-card sidebar-card--cta">
              <h3>¿Necesita Asesoría?</h3>
              <p>Consulte con nuestros expertos para su caso específico</p>
              <a href="/contact" class="btn btn--primary btn--block">Consulta Gratuita</a>
            </div>

            <div class="sidebar-card">
              <h3>Artículos Populares</h3>
              <ul class="popular-posts">
                {blogPosts.slice(0, 4).map(p => (
                  <li>
                    <a href={`/blog/${p.id}`}>
                      <span class="popular-post__title">{p.title}</span>
                      <span class="popular-post__date">
                        {p.pubDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric' })}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </div>

    {relatedPosts.length > 0 && (
      <section class="related-posts section bg-cream">
        <div class="container">
          <h2>Artículos Relacionados</h2>
          <div class="related-grid">
            {relatedPosts.map(relatedPost => (
              <article class="related-card">
                <a href={`/blog/${relatedPost.id}`} class="related-card__image">
                  <img src={relatedPost.image} alt={relatedPost.title} />
                </a>
                <div class="related-card__content">
                  <span class="related-card__category">{relatedPost.category}</span>
                  <h3>
                    <a href={`/blog/${relatedPost.id}`}>{relatedPost.title}</a>
                  </h3>
                  <p>{relatedPost.description.substring(0, 100)}...</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style lang="scss">
  @import '../../styles/variables';
  @import '../../styles/mixins';
  .post-header {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;

    &__image {
      position: absolute;
      inset: 0;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba($primary-dark, 0.3) 0%,
        rgba($primary-dark, 0.8) 70%,
        rgba($primary-dark, 0.95) 100%
      );
    }

    &__content {
      position: relative;
      z-index: 1;
      color: $white;
      padding: $spacing-3xl 0 $spacing-2xl;
      width: 100%;
    }
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: $spacing-sm;
    font-size: $font-size-sm;
    margin-bottom: $spacing-lg;

    a {
      color: rgba($white, 0.7);
      transition: color $transition-base;

      &:hover {
        color: $secondary-gold;
      }
    }

    span:not(:last-child) {
      color: rgba($white, 0.5);
    }

    span:last-child {
      color: rgba($white, 0.9);
    }
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: $spacing-md;
    margin-bottom: $spacing-lg;
    font-size: $font-size-sm;

    .category {
      color: $secondary-gold;
      font-weight: $font-weight-semibold;
    }

    .date, .read-time {
      color: rgba($white, 0.8);
    }
  }

  .post-header h1 {
    font-size: $font-size-2xl;
    color: $white;
    margin-bottom: $spacing-md;
    max-width: 900px;

    @include md {
      font-size: $font-size-3xl;
    }

    @include lg {
      font-size: $font-size-4xl;
    }
  }

  .post-lead {
    font-size: $font-size-lg;
    line-height: 1.8;
    color: rgba($white, 0.9);
    margin-bottom: $spacing-xl;
    max-width: 800px;
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: $spacing-md;

    img {
      width: 56px;
      height: 56px;
      border-radius: $radius-full;
      object-fit: cover;
      border: 3px solid $secondary-gold;
    }

    &__info {
      display: flex;
      flex-direction: column;
    }

    &__name {
      font-size: $font-size-lg;
      font-weight: $font-weight-semibold;
      color: $white;
    }

    &__title {
      font-size: $font-size-sm;
      color: rgba($white, 0.8);
    }
  }

  .content-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-3xl;

    @include lg {
      grid-template-columns: 2.5fr 1fr;
    }
  }

  .post-body {
    max-width: 800px;
  }

  .content-text {
    font-size: $font-size-lg;
    line-height: 1.8;
    color: $gray-dark;

    h2 {
      font-size: $font-size-2xl;
      color: $primary-dark;
      margin: $spacing-2xl 0 $spacing-lg;
      padding-bottom: $spacing-sm;
      border-bottom: 3px solid $secondary-gold;
    }

    p {
      margin-bottom: $spacing-lg;
    }
  }

  .post-tags {
    margin-top: $spacing-3xl;
    padding-top: $spacing-xl;
    border-top: 2px solid $gray-light;

    h3 {
      font-size: $font-size-lg;
      color: $primary-dark;
      margin-bottom: $spacing-md;
    }

    .tags-list {
      display: flex;
      flex-wrap: wrap;
      gap: $spacing-sm;
    }

    .tag {
      padding: $spacing-xs $spacing-md;
      background: $accent-cream;
      color: $gray-dark;
      border-radius: $radius-base;
      font-size: $font-size-sm;
      font-weight: $font-weight-medium;
    }
  }

  .post-share {
    margin-top: $spacing-2xl;

    h3 {
      font-size: $font-size-lg;
      color: $primary-dark;
      margin-bottom: $spacing-md;
    }

    .share-buttons {
      display: flex;
      gap: $spacing-sm;
    }

    .share-button {
      width: 48px;
      height: 48px;
      @include flex-center;
      background: $accent-cream;
      color: $primary-dark;
      border-radius: $radius-base;
      transition: all $transition-base;

      &:hover {
        background: $secondary-gold;
        transform: translateY(-3px);
        box-shadow: $shadow-base;
      }
    }
  }

  .post-sidebar {
    .sidebar-card {
      background: $white;
      padding: $spacing-lg;
      border-radius: $radius-lg;
      box-shadow: $shadow-base;
      margin-bottom: $spacing-lg;

      h3 {
        font-size: $font-size-xl;
        color: $primary-dark;
        margin-bottom: $spacing-md;
      }

      &--cta {
        background: linear-gradient(135deg, $primary-dark 0%, $primary-navy 100%);
        color: $white;

        h3 {
          color: $secondary-gold;
        }

        p {
          color: rgba($white, 0.9);
          margin-bottom: $spacing-md;
        }
      }
    }
  }

  .author-card {
    text-align: center;

    img {
      width: 80px;
      height: 80px;
      border-radius: $radius-full;
      object-fit: cover;
      margin: 0 auto $spacing-md;
      border: 3px solid $secondary-gold;
    }

    h4 {
      font-size: $font-size-lg;
      color: $primary-dark;
      margin-bottom: $spacing-xs;
    }

    p {
      font-size: $font-size-sm;
      color: $gray-medium;
      margin-bottom: $spacing-md;
    }

    .btn-link {
      color: $secondary-gold;
      font-weight: $font-weight-semibold;
      font-size: $font-size-sm;
      transition: gap $transition-base;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .popular-posts {
    list-style: none;
    padding: 0;

    li {
      margin-bottom: $spacing-md;

      &:last-child {
        margin-bottom: 0;
      }

      a {
        display: flex;
        flex-direction: column;
        gap: $spacing-xs;
        padding: $spacing-sm;
        border-radius: $radius-sm;
        transition: background $transition-base;

        &:hover {
          background: $accent-cream;

          .popular-post__title {
            color: $secondary-gold;
          }
        }
      }
    }

    .popular-post__title {
      font-size: $font-size-sm;
      color: $primary-dark;
      font-weight: $font-weight-medium;
      line-height: 1.4;
      transition: color $transition-base;
    }

    .popular-post__date {
      font-size: $font-size-xs;
      color: $gray-medium;
    }
  }

  .btn {
    display: inline-block;
    padding: $spacing-sm $spacing-lg;
    border-radius: $radius-base;
    font-weight: $font-weight-semibold;
    text-align: center;
    transition: all $transition-base;
    text-decoration: none;

    &--primary {
      background: $secondary-gold;
      color: $primary-dark;

      &:hover {
        background: $secondary-light-gold;
        transform: translateY(-2px);
        box-shadow: $shadow-md;
      }
    }

    &--block {
      display: block;
      width: 100%;
    }
  }

  .related-posts {
    h2 {
      text-align: center;
      font-size: $font-size-3xl;
      color: $primary-dark;
      margin-bottom: $spacing-2xl;
    }
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-xl;

    @include md {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .related-card {
    background: $white;
    border-radius: $radius-lg;
    overflow: hidden;
    box-shadow: $shadow-base;
    transition: all $transition-base;

    &:hover {
      transform: translateY(-5px);
      box-shadow: $shadow-lg;
    }

    &__image {
      display: block;
      height: 180px;
      overflow: hidden;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform $transition-slow;
      }

      &:hover img {
        transform: scale(1.1);
      }
    }

    &__content {
      padding: $spacing-lg;
    }

    &__category {
      display: inline-block;
      font-size: $font-size-xs;
      color: $secondary-gold;
      font-weight: $font-weight-semibold;
      margin-bottom: $spacing-sm;
    }

    h3 {
      font-size: $font-size-lg;
      margin-bottom: $spacing-sm;

      a {
        color: $primary-dark;
        transition: color $transition-base;

        &:hover {
          color: $secondary-gold;
        }
      }
    }

    p {
      font-size: $font-size-sm;
      color: $gray-medium;
      line-height: 1.6;
    }
  }
</style>