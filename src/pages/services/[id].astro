---
import BaseLayout from '@layouts/BaseLayout.astro';
import { services } from '@data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout title={service.title} description={service.description}>
  <section class="service-hero">
    <div class="service-hero__image" transition:name={`service-image-${service.id}`}>
      <img src={service.image} alt={service.title} />
      <div class="service-hero__overlay"></div>
    </div>
    <div class="service-hero__content">
      <div class="container">
        <span class="service-hero__icon">{service.icon}</span>
        <h1>{service.title}</h1>
        <p>{service.description}</p>
      </div>
    </div>
  </section>

  <section class="subservices-section section">
    <div class="container">
      <div class="section-header">
        <h2>Nuestros Servicios Especializados</h2>
        <p>Soluciones específicas en {service.title.toLowerCase()}</p>
      </div>

      <div class="subservices-grid">
        {service.subservices.map((subservice) => (
          <article class="subservice-card">
            <a href={`/services/${service.id}/${subservice.id}`} class="subservice-card__link">
              <div class="subservice-card__header">
                <h3>{subservice.title}</h3>
                <span class="subservice-card__arrow">→</span>
              </div>
              <p class="subservice-card__description">{subservice.description}</p>
              <ul class="subservice-card__list">
                {subservice.details.slice(0, 3).map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
              <span class="subservice-card__more">Ver más detalles</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="service-cta section bg-dark">
    <div class="container">
      <div class="cta-content">
        <h2>¿Necesita asesoría en {service.title}?</h2>
        <p>Contacte con nuestros especialistas para una consulta personalizada</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn--primary btn--large">Consulta Gratuita</a>
          <a href="/team" class="btn btn--outline btn--large">Nuestro Equipo</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @import '../../styles/variables';
  @import '../../styles/mixins';
  .service-hero {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    overflow: hidden;

    &__image {
      position: absolute;
      inset: 0;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        135deg,
        rgba($primary-dark, 0.9) 0%,
        rgba($primary-dark, 0.7) 100%
      );
    }

    &__content {
      position: relative;
      z-index: 1;
      color: $white;
      padding: $spacing-3xl 0;

      h1 {
        color: $white;
        font-size: $font-size-3xl;
        margin-bottom: $spacing-md;

        @include md {
          font-size: $font-size-4xl;
        }
      }

      p {
        font-size: $font-size-lg;
        color: rgba($white, 0.9);
        max-width: 700px;
        line-height: 1.8;
      }
    }

    &__icon {
      font-size: 4rem;
      display: block;
      margin-bottom: $spacing-md;
      filter: drop-shadow(0 4px 8px rgba($black, 0.3));
    }
  }

  .section-header {
    text-align: center;
    margin-bottom: $spacing-3xl;

    h2 {
      font-size: $font-size-3xl;
      color: $primary-dark;
      margin-bottom: $spacing-sm;
    }

    p {
      font-size: $font-size-lg;
      color: $gray-medium;
    }
  }

  .subservices-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-xl;

    @include md {
      grid-template-columns: repeat(2, 1fr);
    }

    @include lg {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .subservice-card {
    background: $white;
    border: 2px solid $gray-light;
    border-radius: $radius-lg;
    overflow: hidden;
    transition: all $transition-base;

    &:hover {
      border-color: $secondary-gold;
      transform: translateY(-5px);
      box-shadow: $shadow-lg;
    }

    &__link {
      display: block;
      padding: $spacing-lg;
      text-decoration: none;
      color: inherit;
      height: 100%;
    }

    &__header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: $spacing-md;

      h3 {
        font-size: $font-size-xl;
        color: $primary-dark;
        flex: 1;
        margin: 0;
      }
    }

    &__arrow {
      font-size: $font-size-2xl;
      color: $secondary-gold;
      transition: transform $transition-base;
      flex-shrink: 0;
      margin-left: $spacing-sm;
    }

    &:hover &__arrow {
      transform: translateX(5px);
    }

    &__description {
      color: $gray-dark;
      line-height: 1.6;
      margin-bottom: $spacing-md;
      font-size: $font-size-sm;
    }

    &__list {
      list-style: none;
      padding: 0;
      margin: 0 0 $spacing-md 0;

      li {
        padding-left: $spacing-md;
        margin-bottom: $spacing-xs;
        font-size: $font-size-sm;
        color: $gray-medium;
        position: relative;

        &::before {
          content: '✓';
          position: absolute;
          left: 0;
          color: $secondary-gold;
          font-weight: $font-weight-bold;
        }
      }
    }

    &__more {
      display: inline-block;
      font-size: $font-size-sm;
      color: $secondary-gold;
      font-weight: $font-weight-semibold;
      border-bottom: 2px solid transparent;
      transition: border-color $transition-base;
    }

    &:hover &__more {
      border-bottom-color: $secondary-gold;
    }
  }

  .service-cta {
    text-align: center;
  }

  .cta-content {
    h2 {
      color: $white;
      font-size: $font-size-3xl;
      margin-bottom: $spacing-md;

      @include md {
        font-size: $font-size-4xl;
      }
    }

    p {
      font-size: $font-size-lg;
      color: rgba($white, 0.9);
      margin-bottom: $spacing-xl;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: $spacing-md;
    align-items: center;

    @include sm {
      flex-direction: row;
      justify-content: center;
    }
  }

  .btn {
    display: inline-block;
    padding: $spacing-sm $spacing-lg;
    border-radius: $radius-base;
    font-weight: $font-weight-semibold;
    text-align: center;
    transition: all $transition-base;
    border: 2px solid transparent;
    cursor: pointer;
    text-decoration: none;

    &--primary {
      background: $secondary-gold;
      color: $primary-dark;
      border-color: $secondary-gold;

      &:hover {
        background: $secondary-light-gold;
        border-color: $secondary-light-gold;
        transform: translateY(-2px);
        box-shadow: $shadow-md;
      }
    }

    &--outline {
      background: transparent;
      color: $white;
      border-color: $white;

      &:hover {
        background: $white;
        color: $primary-dark;
      }
    }

    &--large {
      padding: $spacing-md $spacing-xl;
      font-size: $font-size-lg;
    }
  }
</style>