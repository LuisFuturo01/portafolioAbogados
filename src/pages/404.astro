---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Página No Encontrada">
  <section class="error-section">
    <div class="container">
      <div class="error-content">
        <div class="error-scales">
          <svg viewBox="0 0 300 350" class="scales-svg">
            <!-- Broken Scale Representation -->
            <g class="broken-left">
              <line x1="60" y1="100" x2="120" y2="130" stroke="#D4AF37" stroke-width="4" />
              <ellipse cx="80" cy="140" rx="40" ry="10" fill="#D4AF37" opacity="0.6" />
            </g>
            
            <g class="broken-right">
              <line x1="240" y1="100" x2="180" y2="130" stroke="#D4AF37" stroke-width="4" />
              <ellipse cx="220" cy="140" rx="40" ry="10" fill="#D4AF37" opacity="0.6" />
            </g>
            
            <!-- Center Post -->
            <line x1="150" y1="80" x2="150" y2="280" stroke="#D4AF37" stroke-width="6" />
            
            <!-- Broken arm indicator -->
            <line x1="150" y1="100" x2="120" y2="100" stroke="#D4AF37" stroke-width="4" stroke-dasharray="5,5" />
            <line x1="150" y1="100" x2="180" y2="100" stroke="#D4AF37" stroke-width="4" stroke-dasharray="5,5" />
            
            <!-- Cross on top -->
            <line x1="150" y1="40" x2="150" y2="90" stroke="#D4AF37" stroke-width="5" />
            <line x1="135" y1="55" x2="165" y2="55" stroke="#D4AF37" stroke-width="5" />
            
            <!-- Base -->
            <rect x="115" y="280" width="70" height="15" fill="#D4AF37" rx="4" />
          </svg>
        </div>

        <div class="error-text">
          <h1 class="error-code">404</h1>
          <h2>Página No Encontrada</h2>
          <p>Lo sentimos, la balanza de la justicia no puede encontrar la página que busca. Es posible que haya sido movida o ya no exista.</p>
          
          <div class="error-actions">
            <a href="/" class="btn btn--primary">Volver al Inicio</a>
            <a href="/contact" class="btn btn--outline">Contactar Soporte</a>
          </div>

          <div class="quick-links">
            <h3>Enlaces Útiles</h3>
            <div class="links-grid">
              <a href="/services" class="quick-link">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>Servicios</span>
              </a>
              <a href="/team" class="quick-link">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span>Equipo</span>
              </a>
              <a href="/blog" class="quick-link">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Blog</span>
              </a>
              <a href="/contact" class="quick-link">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <span>Contacto</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @import '../styles/_variables';
  @import '../styles/_mixins';
  .error-section {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: $spacing-3xl 0;
    background: linear-gradient(135deg, $accent-cream 0%, $white 100%);
  }

  .error-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-3xl;
    align-items: center;

    @include lg {
      grid-template-columns: 1fr 1.5fr;
    }
  }

  .error-scales {
    display: flex;
    justify-content: center;

    .scales-svg {
      width: 100%;
      max-width: 300px;
      height: auto;
      filter: drop-shadow(0 10px 30px rgba($secondary-gold, 0.3));
    }

    .broken-left,
    .broken-right {
      animation: wobble 2s ease-in-out infinite;
    }

    .broken-right {
      animation-delay: 1s;
    }
  }

  @keyframes wobble {
    0%, 100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-5deg);
    }
    75% {
      transform: rotate(5deg);
    }
  }

  .error-text {
    text-align: center;

    @include lg {
      text-align: left;
    }

    .error-code {
      font-size: 6rem;
      font-weight: $font-weight-bold;
      color: $secondary-gold;
      line-height: 1;
      margin-bottom: $spacing-md;
      text-shadow: 2px 2px 4px rgba($primary-dark, 0.1);

      @include md {
        font-size: 8rem;
      }
    }

    h2 {
      font-size: $font-size-2xl;
      color: $primary-dark;
      margin-bottom: $spacing-md;

      @include md {
        font-size: $font-size-3xl;
      }
    }

    p {
      font-size: $font-size-lg;
      color: $gray-medium;
      line-height: 1.8;
      margin-bottom: $spacing-xl;
      max-width: 600px;

      @include lg {
        margin-left: 0;
        margin-right: auto;
      }
    }
  }

  .error-actions {
    display: flex;
    flex-direction: column;
    gap: $spacing-md;
    margin-bottom: $spacing-3xl;
    align-items: center;

    @include sm {
      flex-direction: row;
    }

    @include lg {
      justify-content: flex-start;
    }
  }

  .btn {
    display: inline-block;
    padding: $spacing-md $spacing-xl;
    border-radius: $radius-base;
    font-weight: $font-weight-semibold;
    text-align: center;
    transition: all $transition-base;
    font-size: $font-size-base;
    border: 2px solid transparent;
    cursor: pointer;
    text-decoration: none;

    &--primary {
      background: $secondary-gold;
      color: $primary-dark;
      border-color: $secondary-gold;

      &:hover {
        background: $secondary-light-gold;
        border-color: $secondary-light-gold;
        transform: translateY(-2px);
        box-shadow: $shadow-md;
      }
    }

    &--outline {
      background: transparent;
      color: $primary-dark;
      border-color: $primary-dark;

      &:hover {
        background: $primary-dark;
        color: $white;
      }
    }
  }

  .quick-links {
    background: $white;
    padding: $spacing-xl;
    border-radius: $radius-lg;
    box-shadow: $shadow-base;

    h3 {
      font-size: $font-size-xl;
      color: $primary-dark;
      margin-bottom: $spacing-lg;
      text-align: center;

      @include lg {
        text-align: left;
      }
    }

    .links-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: $spacing-md;

      @include sm {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .quick-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: $spacing-xs;
      padding: $spacing-md;
      background: $accent-cream;
      border-radius: $radius-base;
      color: $primary-dark;
      transition: all $transition-base;
      text-decoration: none;

      svg {
        color: $secondary-gold;
        transition: transform $transition-base;
      }

      span {
        font-size: $font-size-sm;
        font-weight: $font-weight-semibold;
      }

      &:hover {
        background: $secondary-gold;
        color: $primary-dark;
        transform: translateY(-3px);
        box-shadow: $shadow-base;

        svg {
          transform: scale(1.1);
        }
      }
    }
  }
</style>