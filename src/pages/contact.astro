---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Contacto" description="Póngase en contacto con Shaffer Laws para una consulta legal gratuita.">
  <section class="page-hero">
    <div class="container">
      <h1>Contáctenos</h1>
      <p>Estamos aquí para ayudarle con todas sus necesidades legales</p>
    </div>
  </section>

  <section class="contact-section section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-form-wrapper">
          <h2>Envíenos un Mensaje</h2>
          <p class="form-intro">Complete el formulario y nos pondremos en contacto con usted lo antes posible.</p>

          <form class="contact-form" id="contactForm">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Nombre Completo *</label>
                <input type="text" id="name" name="name" required />
              </div>

              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="phone">Teléfono *</label>
                <input type="tel" id="phone" name="phone" required />
              </div>

              <div class="form-group">
                <label for="service">Área de Interés *</label>
                <select id="service" name="service" required>
                  <option value="">Seleccione una opción</option>
                  <option value="civil">Derecho Civil</option>
                  <option value="corporativo">Derecho Corporativo</option>
                  <option value="laboral">Derecho Laboral</option>
                  <option value="penal">Derecho Penal</option>
                  <option value="familiar">Derecho de Familia</option>
                  <option value="inmobiliario">Derecho Inmobiliario</option>
                  <option value="otro">Otro</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="message">Mensaje *</label>
              <textarea id="message" name="message" rows="6" required></textarea>
            </div>

            <div class="form-group">
              <label class="checkbox-label">
                <input type="checkbox" name="privacy" required />
                <span>He leído y acepto la <a href="/privacy">política de privacidad</a> *</span>
              </label>
            </div>

            <button type="submit" class="btn btn--primary btn--large">Enviar Mensaje</button>
          </form>
        </div>

        <div class="contact-info-wrapper">
          <div class="contact-card">
            <div class="contact-card__icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <h3>Oficina Principal</h3>
            <p>123 Law Street, Suite 400<br>New York, NY 10001<br>United States</p>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <h3>Teléfono</h3>
            <p>
              <a href="tel:+15551234567">+1 (555) 123-4567</a><br>
              <a href="tel:+15551234568">+1 (555) 123-4568</a>
            </p>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <h3>Email</h3>
            <p>
              <a href="mailto:info@shafferlaws.com">info@shafferlaws.com</a><br>
              <a href="mailto:contact@shafferlaws.com">contact@shafferlaws.com</a>
            </p>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3>Horario</h3>
            <p>
              Lunes a Viernes: 9:00 AM - 6:00 PM<br>
              Sábados: 10:00 AM - 2:00 PM<br>
              Domingos: Cerrado
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="map-section">
    <div class="map-placeholder">
      <div class="map-overlay">
        <p>123 Law Street, Suite 400, New York, NY 10001</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @import '../styles/variables';
  @import '../styles/mixins';
  .page-hero {
    background: linear-gradient(135deg, $primary-dark 0%, $primary-navy 100%);
    color: $white;
    padding: $spacing-3xl 0 $spacing-2xl;
    text-align: center;

    h1 {
      color: $white;
      font-size: $font-size-3xl;
      margin-bottom: $spacing-md;

      @include md {
        font-size: $font-size-4xl;
      }
    }

    p {
      font-size: $font-size-lg;
      color: rgba($white, 0.9);
      max-width: 700px;
      margin: 0 auto;
    }
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-3xl;

    @include lg {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .contact-form-wrapper {
    h2 {
      font-size: $font-size-2xl;
      color: $primary-dark;
      margin-bottom: $spacing-sm;
    }

    .form-intro {
      color: $gray-medium;
      margin-bottom: $spacing-xl;
      line-height: 1.6;
    }
  }

  .contact-form {
    .form-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: $spacing-md;
      margin-bottom: $spacing-md;

      @include sm {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .form-group {
      margin-bottom: $spacing-md;

      label {
        display: block;
        font-weight: $font-weight-semibold;
        color: $primary-dark;
        margin-bottom: $spacing-xs;
        font-size: $font-size-sm;
      }

      input,
      select,
      textarea {
        width: 100%;
        padding: $spacing-sm $spacing-md;
        border: 2px solid $gray-light;
        border-radius: $radius-base;
        font-family: inherit;
        font-size: $font-size-base;
        color: $gray-dark;
        transition: border-color $transition-base;

        &:focus {
          outline: none;
          border-color: $secondary-gold;
        }
      }

      textarea {
        resize: vertical;
        min-height: 150px;
      }
    }

    .checkbox-label {
      display: flex;
      align-items: flex-start;
      gap: $spacing-sm;
      cursor: pointer;

      input[type="checkbox"] {
        width: auto;
        margin-top: 4px;
      }

      span {
        font-size: $font-size-sm;
        color: $gray-dark;
        line-height: 1.5;

        a {
          color: $secondary-gold;
          font-weight: $font-weight-semibold;

          &:hover {
            text-decoration: underline;
          }
        }
      }
    }
  }

  .btn {
    display: inline-block;
    padding: $spacing-sm $spacing-lg;
    border-radius: $radius-base;
    font-weight: $font-weight-semibold;
    text-align: center;
    transition: all $transition-base;
    border: none;
    cursor: pointer;
    font-family: inherit;

    &--primary {
      background: $secondary-gold;
      color: $primary-dark;

      &:hover {
        background: $secondary-light-gold;
        transform: translateY(-2px);
        box-shadow: $shadow-md;
      }
    }

    &--large {
      padding: $spacing-md $spacing-xl;
      font-size: $font-size-lg;
      width: 100%;

      @include sm {
        width: auto;
      }
    }
  }

  .contact-info-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-lg;

    @include sm {
      grid-template-columns: repeat(2, 1fr);
    }

    @include lg {
      grid-template-columns: 1fr;
    }
  }

  .contact-card {
    background: $white;
    padding: $spacing-lg;
    border-radius: $radius-lg;
    box-shadow: $shadow-base;
    text-align: center;
    transition: all $transition-base;

    &:hover {
      transform: translateY(-5px);
      box-shadow: $shadow-lg;
    }

    &__icon {
      width: 64px;
      height: 64px;
      @include flex-center;
      background: $accent-cream;
      color: $secondary-gold;
      border-radius: $radius-full;
      margin: 0 auto $spacing-md;
    }

    h3 {
      font-size: $font-size-lg;
      color: $primary-dark;
      margin-bottom: $spacing-sm;
    }

    p {
      color: $gray-medium;
      font-size: $font-size-sm;
      line-height: 1.8;

      a {
        color: $secondary-gold;
        font-weight: $font-weight-medium;
        transition: color $transition-base;

        &:hover {
          color: $primary-dark;
          text-decoration: underline;
        }
      }
    }
  }

  .map-section {
    margin-top: $spacing-3xl;
  }

  .map-placeholder {
    position: relative;
    height: 400px;
    background: linear-gradient(135deg, $primary-dark 0%, $primary-navy 100%);
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: 
        repeating-linear-gradient(45deg, transparent, transparent 35px, rgba($secondary-gold, 0.1) 35px, rgba($secondary-gold, 0.1) 70px);
    }

    .map-overlay {
      position: absolute;
      inset: 0;
      @include flex-center;
      background: rgba($primary-dark, 0.8);

      p {
        color: $white;
        font-size: $font-size-xl;
        font-weight: $font-weight-semibold;
        text-align: center;
        padding: $spacing-xl;
      }
    }
  }
</style>

<script>
  const contactForm = document.getElementById('contactForm') as HTMLFormElement;

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    const formData = new FormData(contactForm);
    const data = Object.fromEntries(formData);

    console.log('Form submitted:', data);

    // Show success message
    alert('¡Gracias por contactarnos! Nos pondremos en contacto con usted pronto.');
    contactForm.reset();
  });
</script>