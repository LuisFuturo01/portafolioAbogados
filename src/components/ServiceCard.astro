---
import type { Service } from '@data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="service-card">
  <a href={`/services/${service.id}`} class="service-card__link" data-astro-prefetch>
    <div class="service-card__image" transition:name={`service-image-${service.id}`}>
      <img src={service.image} alt={service.title} />
      <div class="service-card__overlay">
        <span class="service-card__icon">{service.icon}</span>
      </div>
    </div>
    
    <div class="service-card__content">
      <h3 class="service-card__title">{service.title}</h3>
      <p class="service-card__description">{service.description}</p>
      
      <div class="service-card__footer">
        <span class="service-card__count">
          {service.subservices.length} servicios
        </span>
        <span class="service-card__arrow">→</span>
      </div>
    </div>
  </a>
</article>

<style lang="scss">
  @import '../styles/variables';
    @import '../styles/mixins';
  .service-card {
    background: $white;
    border-radius: $radius-lg;
    overflow: hidden;
    box-shadow: $shadow-base;
    transition: all $transition-base;

    &:hover {
      transform: translateY(-8px);
      box-shadow: $shadow-xl;
    }

    &__link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    &__image {
      position: relative;
      height: 250px;
      overflow: hidden;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform $transition-slow;
      }

      &:hover img {
        transform: scale(1.1);
      }
    }

    &__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        rgba($primary-dark, 0.3) 50%,
        rgba($primary-dark, 0.8) 100%
      );
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      padding: $spacing-lg;
    }

    &__icon {
      font-size: 3rem;
      filter: drop-shadow(0 4px 8px rgba($black, 0.3));
    }

    &__content {
      padding: $spacing-lg;
    }

    &__title {
      font-size: $font-size-xl;
      color: $primary-dark;
      margin-bottom: $spacing-sm;
      font-weight: $font-weight-bold;
    }

    &__description {
      color: $gray-medium;
      line-height: 1.6;
      margin-bottom: $spacing-md;
      font-size: $font-size-sm;
    }

    &__footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: $spacing-sm;
      border-top: 1px solid $gray-light;
    }

    &__count {
      font-size: $font-size-sm;
      color: $secondary-gold;
      font-weight: $font-weight-semibold;
    }

    &__arrow {
      font-size: $font-size-xl;
      color: $secondary-gold;
      transition: transform $transition-base;
    }

    &:hover &__arrow {
      transform: translateX(5px);
    }
  }
</style>