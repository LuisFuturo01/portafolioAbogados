---
const currentPath = Astro.url.pathname;
import Facebook from './svg/Facebook.astro';
import Instragram from './svg/Instragram.astro';
import Linkedin from './svg/Linkedin.astro';
---

<header class="header" id="mainHeader">
  <div class="header__container">
    <a href="/" class="header__logo">
      <div class="header__logo-bars">
        <span class="bar bar--gold"></span>
        <span class="bar bar--cream"></span>
      </div>
      <span class="header__logo-text">ABOGADOS J-R</span>
    </a>

    <button class="header__toggle" aria-label="Toggle menu" id="menuToggle">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="header__nav" id="mainNav">
      <a data-astro-prefetch href="/" class={currentPath === '/' ? 'active' : ''}>Inicio</a>
      <a data-astro-prefetch href="/team" class={currentPath.startsWith('/team') ? 'active' : ''}>Equipo</a>
      <a data-astro-prefetch href="/services" class={currentPath.startsWith('/services') ? 'active' : ''}>Servicios</a>
      <a data-astro-prefetch href="/blog" class={currentPath.startsWith('/blog') ? 'active' : ''}>Blog</a>
      <a data-astro-prefetch href="/contact" class={currentPath === '/contact' ? 'active' : ''}>Contacto</a>
    </nav>

    <div class="header__social">
      <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
        <Facebook />
      </a>
      <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
        <Instragram />
      </a>
      <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn">
        <Linkedin />
      </a>
    </div>
  </div>
</header>

<style lang="scss">
  // VOLVEMOS A IMPORT (Ignora los warnings de deprecación por ahora)
  @import '../styles/variables';
  @import '../styles/mixins';

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: rgba($primary-dark, 0.95);
    backdrop-filter: blur(10px);
    z-index: 1000;
    transition: all $transition-base;

    &__container {
      @include container;
      @include flex-between;
      padding-top: $spacing-sm;
      padding-bottom: $spacing-sm;
      gap: $spacing-md;
      align-items: center; 
    }

    &__logo {
      @include flex-center;
      gap: $spacing-sm;
      font-family: $font-primary;
      font-weight: $font-weight-bold;
      color: $white;
      font-size: $font-size-lg;
      text-decoration: none;
      transition: color $transition-base;
      z-index: 1002; // El logo debe estar sobre el menú abierto

      &:hover {
        color: $secondary-gold;
      }
    }

    &__logo-bars {
      display: flex;
      gap: 4px;
      height: 32px;

      .bar {
        width: 4px;
        height: 100%;
        &--gold { background: linear-gradient(to bottom, $secondary-gold, $secondary-light-gold); }
        &--cream { background: $accent-cream; }
      }
    }

    &__toggle {
      display: flex;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: $spacing-xs;
      z-index: 1002; // El botón debe estar sobre el menú abierto

      @include md {
        display: none;
      }

      span {
        width: 25px;
        height: 2px;
        background-color: $secondary-gold;
        transition: all $transition-base;
      }

      &.active {
        span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
        span:nth-child(2) { opacity: 0; }
        span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }
      }
    }

    &__nav {
      display: none; // Oculto por defecto en móvil
      
      // ESTILOS DE MENÚ ABIERTO (CORREGIDO)
      &.active {
        display: flex;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        height: 100vh; // Ocupa toda la pantalla
        background-color: $primary-dark;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: $spacing-lg;
        gap: $spacing-lg;
        z-index: 1001; // Debajo del botón y logo
      }

      @include md {
        display: flex;
        position: static;
        height: auto;
        flex-direction: row;
        background: none;
        padding: 0;
        box-shadow: none;
        gap: $spacing-lg;
      }

      a {
        color: $white;
        font-weight: $font-weight-medium;
        font-size: 1.2rem; // Más grande en móvil
        padding: $spacing-xs 0;
        border-bottom: 2px solid transparent;
        transition: all $transition-base;

        @include md {
          font-size: $font-size-base;
          padding: $spacing-xs;
        }

        &:hover,
        &.active {
          color: $secondary-gold;
          border-bottom-color: $secondary-gold;
        }
      }
    }

    &__social {
      display: none;
      @include md { display: flex; gap: $spacing-sm; }
      
      a {
        color: $white;
        transition: color $transition-base;
        &:hover { color: $secondary-gold; }
      }
    }
  }

  :global(body) {
    padding-top: 70px;
  }
  
  // Evitar scroll cuando el menú está abierto
  :global(body.menu-open) {
    overflow: hidden;
  }
</style>

<script>
  // Script robusto para Astro
  function initHeader() {
    const menuToggle = document.getElementById('menuToggle');
    const mainNav = document.getElementById('mainNav');
    const body = document.body;

    if (!menuToggle || !mainNav) return;

    // Clonar el botón para asegurar que no se dupliquen eventos al navegar
    const newMenuToggle = menuToggle.cloneNode(true);
    if (menuToggle.parentNode) {
      menuToggle.parentNode.replaceChild(newMenuToggle, menuToggle);
    }

    // Toggle del menú
    newMenuToggle.addEventListener('click', () => {
      newMenuToggle.classList.toggle('active');
      mainNav.classList.toggle('active');
      body.classList.toggle('menu-open');
    });

    // Cerrar al hacer click en un enlace
    const navLinks = mainNav.querySelectorAll('a');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        newMenuToggle.classList.remove('active');
        mainNav.classList.remove('active');
        body.classList.remove('menu-open');
      });
    });
  }

  // Ejecutar script inmediatamente
  initHeader();

  // Ejecutar script en cada navegación de Astro (importante)
  document.addEventListener('astro:page-load', initHeader);
</script>