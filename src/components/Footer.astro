---
import Facebook from './svg/Facebook.astro';
import Instragram from './svg/Instragram.astro';
import LinkedIn from './svg/Linkedin.astro';
import { services } from '@data/services';
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__top">
    <div class="footer__container">
      <div class="footer__section">
        <div class="footer__logo">
          <div class="footer__logo-bars">
            <span class="bar bar--gold"></span>
            <span class="bar bar--cream"></span>
          </div>
          <h3>ABOGADOS J-R</h3>
        </div>
        <p class="footer__tagline">
          Excelencia legal al servicio de nuestros clientes desde 2005
        </p>
        <div class="footer__social">
          <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
            <Facebook />
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
            <Instragram />
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn">
            <LinkedIn />
          </a>
          
        </div>
      </div>

      <div class="footer__section">
        <h4>Servicios</h4>
        <ul>
          {services.map((service) => (
            <li key={service.id}>
              <a href={`/services/${service.id}`}>{service.title}</a>
            </li>
          ))}
          
        </ul>
      </div>

      <div class="footer__section">
        <h4>Empresa</h4>
        <ul>
          <li><a href="/team">Nuestro Equipo</a></li>
          <li><a href="/blog">Blog Legal</a></li>
          <li><a href="/contact">Contacto</a></li>
          <li><a href="/privacy">Política de Privacidad</a></li>
          <li><a href="/terms">Términos y Condiciones</a></li>
        </ul>
      </div>

      <div class="footer__section">
        <h4>Contacto</h4>
        <ul class="footer__contact">
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>123 Law Street, Suite 400<br>New York, NY 10001</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>+1 (555) 123-4567</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>info@shafferlaws.com</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__container">
      <p>&copy; {currentYear} Shaffer Laws. Todos los derechos reservados.</p>
      <p>Diseñado con excelencia legal</p>
    </div>
  </div>
</footer>

<style lang="scss">
    @import '../styles/variables';
    @import '../styles/mixins';
  .footer {
    background-color: $primary-dark;
    color: $white;

    &__top {
      padding: $spacing-3xl 0 $spacing-2xl;
      border-bottom: 1px solid rgba($secondary-gold, 0.2);
    }

    &__container {
      @include container;
      display: grid;
      grid-template-columns: 1fr;
      gap: $spacing-xl;

      @include sm {
        grid-template-columns: repeat(2, 1fr);
      }

      @include lg {
        grid-template-columns: 2fr 1fr 1fr 1.5fr;
      }
    }

    &__logo {
      @include flex-center;
      justify-content: flex-start;
      gap: $spacing-sm;
      margin-bottom: $spacing-md;

      h3 {
        font-family: $font-primary;
        font-size: $font-size-xl;
        color: $white;
        margin: 0;
      }
    }

    &__logo-bars {
      display: flex;
      gap: 4px;
      height: 32px;

      .bar {
        width: 4px;
        height: 100%;

        &--gold {
          background: linear-gradient(to bottom, $secondary-gold, $secondary-light-gold);
        }

        &--cream {
          background: $accent-cream;
        }
      }
    }

    &__tagline {
      color: rgba($white, 0.8);
      margin-bottom: $spacing-lg;
      font-size: $font-size-sm;
      line-height: 1.6;
    }

    &__social {
      display: flex;
      gap: $spacing-sm;

      a {
        width: 40px;
        height: 40px;
        @include flex-center;
        background-color: rgba($secondary-gold, 0.1);
        border-radius: $radius-base;
        color: $secondary-gold;
        transition: all $transition-base;

        &:hover {
          background-color: $secondary-gold;
          color: $primary-dark;
          transform: translateY(-3px);
        }
      }
    }

    &__section {
      h4 {
        color: $secondary-gold;
        font-size: $font-size-lg;
        margin-bottom: $spacing-md;
        font-weight: $font-weight-semibold;
      }

      ul {
        list-style: none;
        padding: 0;
        margin: 0;

        li {
          margin-bottom: $spacing-sm;

          a {
            color: rgba($white, 0.8);
            font-size: $font-size-sm;
            transition: color $transition-base;

            &:hover {
              color: $secondary-gold;
            }
          }
        }
      }
    }

    &__contact {
      li {
        display: flex;
        align-items: flex-start;
        gap: $spacing-sm;
        color: rgba($white, 0.8);
        font-size: $font-size-sm;

        svg {
          flex-shrink: 0;
          margin-top: 2px;
          color: $secondary-gold;
        }
      }
    }

    &__bottom {
      padding: $spacing-lg 0;

      .footer__container {
        @include flex-between;
        flex-direction: column;
        gap: $spacing-sm;
        text-align: center;

        @include md {
          flex-direction: row;
          text-align: left;
        }

        p {
          margin: 0;
          font-size: $font-size-sm;
          color: rgba($white, 0.6);
        }
      }
    }
  }
</style>